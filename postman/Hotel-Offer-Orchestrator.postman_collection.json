{
  "info": {
    "name": "Hotel Offer Orchestrator",
    "description": "Requests and assertions for supplier mocks, Temporal-backed offer aggregation, Redis price filtering, validation, and health status.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const health = pm.response.json();",
              "pm.collectionVariables.set(\"supplierAStatus\", health.suppliers.supplierA);",
              "pm.collectionVariables.set(\"supplierBStatus\", health.suppliers.supplierB);",
              "pm.collectionVariables.set(\"redisStatus\", health.redis);",
              "const allUp = health.suppliers.supplierA === \"up\" && health.suppliers.supplierB === \"up\" && health.redis === \"up\";",
              "pm.test(\"health status reflects live dependencies\", function () {",
              "  pm.response.to.have.status(allUp ? 200 : 503);",
              "  pm.expect(health.status).to.eql(allUp ? \"ok\" : \"degraded\");",
              "});",
              "pm.test(\"reports both suppliers and Redis\", function () {",
              "  pm.expect([\"up\", \"down\"]).to.include(health.suppliers.supplierA);",
              "  pm.expect([\"up\", \"down\"]).to.include(health.suppliers.supplierB);",
              "  pm.expect(health.redis).to.eql(\"up\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Supplier outage behavior (refresh)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/hotels?city=delhi&refresh=true"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const aUp = pm.collectionVariables.get(\"supplierAStatus\") === \"up\";",
              "const bUp = pm.collectionVariables.get(\"supplierBStatus\") === \"up\";",
              "if (!aUp && !bUp) {",
              "  pm.test(\"returns 502 only when both suppliers are unavailable\", function () { pm.response.to.have.status(502); });",
              "} else {",
              "  pm.test(\"returns offers from each available supplier\", function () {",
              "    pm.response.to.have.status(200);",
              "    const offers = pm.response.json();",
              "    pm.expect(offers).to.be.an(\"array\").that.is.not.empty;",
              "    const names = offers.map((offer) => offer.name.trim().toLowerCase().replace(/\\s+/g, \" \"));",
              "    pm.expect(new Set(names).size).to.eql(names.length);",
              "    offers.forEach((offer) => {",
              "      pm.expect(offer).to.have.all.keys(\"name\", \"price\", \"supplier\", \"commissionPct\");",
              "      if (!aUp) pm.expect(offer.supplier).to.eql(\"Supplier B\");",
              "      if (!bUp) pm.expect(offer.supplier).to.eql(\"Supplier A\");",
              "    });",
              "    if (aUp && bUp) {",
              "      pm.expect(offers.find((offer) => offer.name.toLowerCase() === \"holtin\")).to.include({ price: 5340, supplier: \"Supplier B\" });",
              "      pm.expect(offers.find((offer) => offer.name.toLowerCase() === \"radison\")).to.include({ price: 5900, supplier: \"Supplier A\" });",
              "    }",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Aggregate Delhi offers",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/hotels?city=delhi"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const aUp = pm.collectionVariables.get(\"supplierAStatus\") === \"up\";",
              "const bUp = pm.collectionVariables.get(\"supplierBStatus\") === \"up\";",
              "if (!aUp && !bUp) {",
              "  pm.test(\"uses cached offers or returns 502 when both suppliers are down\", function () { pm.expect([200, 502]).to.include(pm.response.code); });",
              "  if (pm.response.code === 200) pm.expect(pm.response.json()).to.be.an(\"array\").that.is.not.empty;",
              "} else {",
              "  pm.test(\"returns offers from each available supplier\", function () {",
              "    pm.response.to.have.status(200);",
              "    const offers = pm.response.json();",
              "    pm.expect(offers).to.be.an(\"array\").that.is.not.empty;",
              "    const names = offers.map((offer) => offer.name.trim().toLowerCase().replace(/\\s+/g, \" \"));",
              "    pm.expect(new Set(names).size).to.eql(names.length);",
              "    offers.forEach((offer) => {",
              "      pm.expect(offer).to.have.all.keys(\"name\", \"price\", \"supplier\", \"commissionPct\");",
              "      if (!aUp) pm.expect(offer.supplier).to.eql(\"Supplier B\");",
              "      if (!bUp) pm.expect(offer.supplier).to.eql(\"Supplier A\");",
              "    });",
              "    if (aUp && bUp) {",
              "      pm.expect(offers.find((offer) => offer.name.toLowerCase() === \"holtin\")).to.include({ price: 5340, supplier: \"Supplier B\" });",
              "      pm.expect(offers.find((offer) => offer.name.toLowerCase() === \"radison\")).to.include({ price: 5900, supplier: \"Supplier A\" });",
              "    }",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Filter Delhi offers by price",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/hotels?city=delhi&minPrice=5000&maxPrice=9000"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const bothDown = pm.collectionVariables.get(\"supplierAStatus\") === \"down\" && pm.collectionVariables.get(\"supplierBStatus\") === \"down\";",
              "pm.test(\"filters cached prices or reports both suppliers unavailable\", function () {",
              "  if (bothDown) pm.expect([200, 502]).to.include(pm.response.code);",
              "  else pm.response.to.have.status(200);",
              "  if (pm.response.code === 200) {",
              "    const offers = pm.response.json();",
              "    pm.expect(offers).to.be.an(\"array\").that.is.not.empty;",
              "    offers.forEach((offer) => pm.expect(offer.price).to.be.within(5000, 9000));",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "City with no results",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/hotels?city=atlantis"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const bothDown = pm.collectionVariables.get(\"supplierAStatus\") === \"down\" && pm.collectionVariables.get(\"supplierBStatus\") === \"down\";",
              "pm.test(\"returns an empty array or reports both suppliers unavailable\", function () {",
              "  if (bothDown) pm.expect([200, 502]).to.include(pm.response.code);",
              "  else pm.response.to.have.status(200);",
              "  if (pm.response.code === 200) pm.expect(pm.response.json()).to.eql([]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Supplier A mock endpoint",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/supplierA/hotels?city=delhi"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const expected = pm.collectionVariables.get(\"supplierAStatus\") === \"up\" ? 200 : 503;",
              "pm.test(\"matches live supplier availability\", function () { pm.response.to.have.status(expected); });",
              "if (expected === 200) {",
              "  const hotels = pm.response.json();",
              "  pm.test(\"returns supplier hotel records\", function () {",
              "    pm.expect(hotels).to.be.an(\"array\").that.is.not.empty;",
              "    const names = hotels.map((hotel) => hotel.name);",
              "    pm.expect(names).to.include(\"Holtin\");",
              "    pm.expect(names).to.include(\"Radison\");",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Supplier B mock endpoint",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/supplierB/hotels?city=delhi"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const expected = pm.collectionVariables.get(\"supplierBStatus\") === \"up\" ? 200 : 503;",
              "pm.test(\"matches live supplier availability\", function () { pm.response.to.have.status(expected); });",
              "if (expected === 200) {",
              "  const hotels = pm.response.json();",
              "  pm.test(\"returns supplier hotel records\", function () {",
              "    pm.expect(hotels).to.be.an(\"array\").that.is.not.empty;",
              "    const names = hotels.map((hotel) => hotel.name);",
              "    pm.expect(names).to.include(\"Holtin\");",
              "    pm.expect(names).to.include(\"Radison\");",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing city is rejected",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/hotels"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns HTTP 400', function () { pm.response.to.have.status(400); });",
              "pm.test('explains that city is required', function () {",
              "  pm.expect(pm.response.json().error).to.include(\"'city' is required\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid price range is rejected",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/hotels?city=delhi&minPrice=9000&maxPrice=5000"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns HTTP 400', function () { pm.response.to.have.status(400); });",
              "pm.test('explains that the minimum cannot exceed the maximum', function () {",
              "  pm.expect(pm.response.json().error).to.include('minPrice must be less than or equal to maxPrice');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}